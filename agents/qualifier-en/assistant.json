{
  "name": "YCAT Demo Qualifier - Elias (EN)",
  "model": {
    "provider": "openai",
    "model": "gpt-4o",
    "temperature": 0.4,
    "messages": [
      {
        "role": "system",
        "content": "@file:prompt.md"
      }
    ],
    "toolIds": [
      "@tool:check_availability",
      "@tool:book_appointment"
    ]
  },
  "voice": {
    "provider": "vapi",
    "voiceId": "Elliot"
  },
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-3",
    "language": "en",
    "fallbackPlan": {
      "autoFallback": {
        "enabled": true
      }
    }
  },
  "firstMessageMode": "assistant-speaks-first-with-model-generated-message",
  "startSpeakingPlan": {
    "waitSeconds": 0.3
  },
  "endCallFunctionEnabled": true,
  "maxDurationSeconds": 600,
  "analysisPlan": {
    "summaryPlan": {
      "enabled": false
    },
    "successEvaluationPlan": {
      "enabled": false
    }
  },
  "artifactPlan": {
    "structuredOutputIds": [
      "@so:service_interest",
      "@so:motivation",
      "@so:urgency",
      "@so:past_experience",
      "@so:budget",
      "@so:call_summary",
      "@so:appointment_interest",
      "@so:callback_window"
    ]
  }
}
