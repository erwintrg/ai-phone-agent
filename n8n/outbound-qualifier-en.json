    {
      "parameters": {
        "jsCode": "// E.164 normalization, international (no default country). Output key 'Phone Number'.\nconst items = $input.all();\nreturn items.map(item => {\n  const raw = String(item.json['Phone'] ?? '').trim();\n  const digits = raw.replace(/\\D/g, '');\n  let out = 'incorrect format';\n  if (raw.startsWith('+') && digits.length >= 8 && digits.length <= 15) out = '+' + digits;\n  else if (digits.startsWith('00') && digits.length - 2 >= 8 && digits.length - 2 <= 15) out = '+' + digits.slice(2);\n  return { json: { ...item.json, 'Phone Number': out } };\n});"
      },
      "name": "Normalize Phone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ]
    },
