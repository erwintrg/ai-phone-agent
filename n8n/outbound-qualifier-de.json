      "parameters": {
        "jsCode": "// E.164 normalization, German default. Output key 'Phone Number'.\nconst items = $input.all();\nreturn items.map(item => {\n  let raw = String(item.json['Telefonnummer'] ?? '').trim();\n  let plus = raw.startsWith('+');\n  let digits = raw.replace(/\\D/g, '');\n  let out;\n  if (plus) {\n    out = (digits.length >= 8 && digits.length <= 15) ? '+' + digits : 'incorrect format';\n  } else if (digits.startsWith('00')) {\n    const rest = digits.slice(2);\n    out = (rest.length >= 8 && rest.length <= 15) ? '+' + rest : 'incorrect format';\n  } else if (digits.startsWith('0')) {\n    const rest = digits.slice(1);\n    out = (rest.length >= 7 && rest.length <= 13) ? '+49' + rest : 'incorrect format';\n  } else {\n    out = 'incorrect format';\n  }\n  return { json: { ...item.json, 'Phone Number': out } };\n});"
      },
      "name": "Normalize Phone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ]
