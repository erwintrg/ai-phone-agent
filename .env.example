# Real mode only. The offline demo (python demo.py) needs none of this.
# Copy to .env and fill in. .env is git-ignored.

# Vapi private API key (Vapi dashboard > API Keys)
VAPI_API_KEY=
# VAPI_BASE_URL=https://api.vapi.ai

# Shared secret that Vapi sends as the x-vapi-secret header on every tool call.
# Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(16))"
VAPI_WEBHOOK_SECRET=

# Your n8n instance, e.g. https://n8n.example.com
# Webhook URLs default to <N8N_BASE_URL>/webhook/vapi-calendar and
# <N8N_BASE_URL>/webhook/vapi-inbound-report. Override them if your paths differ.
N8N_BASE_URL=
# CALENDAR_WEBHOOK_URL=
# REPORT_WEBHOOK_URL=

# Google Calendar checked with freeBusy and used for bookings, e.g. you@example.com
GOOGLE_CALENDAR_ID=
# Google Sheet with the tabs "Demo Submissions" and "Inbound Calls"
GOOGLE_SHEET_ID=
# Recipient of the front desk call summaries, e.g. you@example.com
NOTIFY_EMAIL=

# Vapi phone number id used for outbound calls (Vapi dashboard > Phone Numbers)
VAPI_PHONE_NUMBER_ID=
